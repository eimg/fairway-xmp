{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fairway XMP",
  "version": "0.1.0-alpha.3",
  "identifier": "dev.fairway.environment",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Fairway XMP", "width": 1080, "height": 760, "minWidth": 820, "minHeight": 650 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "resources/runtime/": "runtime/", "../packaging/macos/Uninstall Fairway XMP.command": "Uninstall Fairway XMP.command" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Your classroom PHP environment",
    "category": "DeveloperTool",
    "macOS": { "minimumSystemVersion": "15.0" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "../packaging/windows/hooks.nsh",
        "minimumWebview2Version": "120.0.0.0"
      },
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
