{
  "name": "fairway-xmp",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "site:build": "node website/build.mjs",
    "site:dev": "node website/build.mjs && node website/serve.mjs",
    "site:check": "node website/build.mjs && node website/check.mjs && node --test website/device.test.mjs",
    "site:test:navigation": "node website/build.mjs && node --test website/navigation.test.mjs",
    "tauri": "tauri",
    "runtime:prepare": "python3 scripts/prepare_runtime.py",
    "test:scripts": "python3 -m unittest discover -s tests -v",
    "test:unit": "node scripts/test_unit.mjs",
    "dev:ui": "vite --host 127.0.0.1 --mode ui-test",
    "test:ui": "playwright test",
    "test:ui:report": "playwright show-report",
    "site:test:theme": "node website/build.mjs && node --test website/theme.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/xterm": "5.5.0",
    "lucide-react": "0.542.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.13.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
